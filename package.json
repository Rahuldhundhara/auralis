{
  "name": "auralis",
  "productName": "Auralis",
  "version": "1.0.2",
  "description": "Auralis - a desktop YouTube Music client for Windows",
  "author": "Auralis",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/Rahuldhundhara/auralis#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rahuldhundhara/auralis.git"
  },
  "bugs": {
    "url": "https://github.com/Rahuldhundhara/auralis/issues"
  },
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && npm run build:main && cross-env AURALIS_DEV=1 electron .\"",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dist": "npm run build && electron-builder --win",
    "dist:portable": "npm run build && electron-builder --win portable",
    "preview": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "test:api": "tsx scripts/test-api.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.5",
    "wait-on": "^9.0.0"
  },
  "dependencies": {
    "discord-rpc": "^4.0.1",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "allowScripts": {
    "electron@45.0.0": true,
    "esbuild@0.28.2": true,
    "sharp@0.35.5": true
  },
  "build": {
    "appId": "com.auralis.music",
    "productName": "Auralis",
    "copyright": "Copyright © 2026 Auralis",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Auralis",
      "uninstallDisplayName": "Auralis",
      "artifactName": "Auralis-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Auralis-Portable-${version}.${ext}"
    }
  }
}
